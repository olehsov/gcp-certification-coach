#!/usr/bin/env bash
# Pre-push: scan the commits being pushed, re-check all tracked files, validate the plugin.
# Enabled by scripts/setup-hooks.sh. Never bypass with --no-verify.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
REMOTE="${1:-origin}"
ZERO="0000000000000000000000000000000000000000"
fail=0

ranges=()
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue            # branch deletion: nothing to scan
  if [ "$remote_sha" = "$ZERO" ]; then
    ranges+=("$local_sha --not --remotes=$REMOTE")   # new branch: commits not yet on the remote
  else
    ranges+=("$remote_sha..$local_sha")
  fi
done

if command -v gitleaks >/dev/null 2>&1; then
  for r in "${ranges[@]:-}"; do
    [ -z "$r" ] && continue
    echo "pre-push: gitleaks on commits $r"
    if gitleaks help git >/dev/null 2>&1; then
      gitleaks git --redact --no-banner --log-opts="$r" "$ROOT" || fail=1
    else
      gitleaks detect --redact --no-banner --source "$ROOT" --log-opts="$r" || fail=1
    fi
  done
else
  echo "pre-push: gitleaks not installed, history scan skipped (CI always runs it; install: brew install gitleaks)"
fi

echo "pre-push: privacy check on all tracked files"
"$ROOT/scripts/check-privacy.sh" --tracked || fail=1

if command -v claude >/dev/null 2>&1; then
  if [ -d "$ROOT/plugins/gcp-cert-coach" ]; then
    echo "pre-push: claude plugin validate"
    (cd "$ROOT" && claude plugin validate ./plugins/gcp-cert-coach) || fail=1
    (cd "$ROOT" && claude plugin validate .) || fail=1
  else
    echo "pre-push: WARNING plugins/gcp-cert-coach not found, plugin validate skipped"
  fi
else
  echo "pre-push: WARNING claude CLI not on PATH, plugin validate skipped"
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-push: BLOCKED. Fix the findings above before pushing."
  exit 1
fi
echo "pre-push: all checks passed"
